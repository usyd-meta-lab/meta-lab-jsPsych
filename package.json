{
  "name": "meta-lab-jspsych",
  "version": "0.1.0",
  "private": true,
  "description": "USYD Meta Lab jsPsych v8 experiment template",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:jatos": "node scripts/build-jatos.mjs --check && vite build && node scripts/build-jatos.mjs",
    "build:preview": "vite build --mode preview",
    "jatos:stop": "node scripts/jatos-local.mjs stop",
    "jatos": "node scripts/jatos-local.mjs start"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/usyd-meta-lab/meta-lab-jsPsych.git"
  },
  "dependencies": {
    "@jspsych/extension-pipe": "^0.2.0",
    "@jspsych/plugin-html-keyboard-response": "^2.2.0",
    "jspsych": "^8.3.0"
  },
  "devDependencies": {
    "fflate": "^0.8.3",
    "vite": "^8.3.1",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
