{
  "extraKnownMarketplaces": {
    "usyd-meta-lab": {
      "source": {
        "source": "github",
        "repo": "usyd-meta-lab/meta-lab-jsPsych"
      }
    }
  },
  "enabledPlugins": {
    "meta-lab@usyd-meta-lab": true
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ ! -d \"$CLAUDE_PROJECT_DIR/node_modules\" ]; then cd \"$CLAUDE_PROJECT_DIR\" && npm install --no-audit --no-fund; fi"
          }
        ]
      }
    ]
  }
}
